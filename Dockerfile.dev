# 前端开发镜像：只装依赖。源码由 compose bind-mount 到 /app，Vite 在容器内跑。
#
# 相对「npm ci + package-lock + 整目录挂载」：
# - 本仓库 packageManager 是 pnpm@10.33.0，锁文件是 pnpm-lock.yaml
# - 不把源码打进镜像；node_modules 用具名卷，避免 bind-mount 盖掉
# - --ignore-scripts：跳过 postinstall 里改 git hooks（容器内无意义且会失败）
# - 用 vp 起开发服务器，与项目工具链一致
#
# 使用：docker compose up --build

FROM node:24-bookworm-slim

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    NODE_ENV=development

RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --ignore-scripts
RUN sha256sum package.json pnpm-lock.yaml > node_modules/.pnpm-dev-stamp

COPY docker/dev-entrypoint.sh /usr/local/bin/dev-entrypoint.sh
RUN chmod +x /usr/local/bin/dev-entrypoint.sh

EXPOSE 5173

ENTRYPOINT ["dev-entrypoint.sh"]
CMD ["pnpm", "exec", "vp", "dev", "--host", "0.0.0.0", "--port", "5173", "--strictPort"]

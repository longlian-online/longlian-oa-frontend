    "operationId": "reviewDeletionRequest",
    "parameters": [
      {
        "in": "query",
        "name": "sessionContext",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/SessionContext"
        }
      },
      {
        "description": "删除申请ID",
        "in": "path",
        "name": "requestId",
        "required": true,
        "schema": {
          "format": "int64",
          "type": "integer"
        }
      }
    ],
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/DeletionRequestReviewDTO"
          }
        }
      },
      "required": true
    },
    "responses": {
      "200": {
        "description": "OK"
      }
    },
    "summary": "审核删除申请",
    "tags": ["删除申请"]
  },
  "path": "/orgadmin/deletion-requests/{requestId}",
  "sourceUrl": "https://sit.neo.oa.api.longlian.online/v3/api-docs/%E7%BB%84%E7%BB%87%E7%AE%A1%E7%90%86%E7%AB%AF"

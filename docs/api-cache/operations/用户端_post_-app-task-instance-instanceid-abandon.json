{
  "document": "用户端",
  "method": "POST",
  "operation": {
    "description": "放弃已接取（CLAIMED）的任务，任务状态恢复为 PENDING，可由他人重新接取",
    "operationId": "abandonTask",
    "parameters": [
      {
        "in": "query",
        "name": "sessionContext",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/SessionContext"
        }
      },
      {
        "description": "任务实例ID",
        "in": "path",
        "name": "instanceId",
        "required": true,
        "schema": {
          "format": "int64",
          "type": "integer"
        }
      }
    ],
    "responses": {
      "200": {
        "description": "OK"
      }
    },
    "summary": "放弃任务",
    "tags": ["任务实例接口"]
  },
  "path": "/app/task/instance/{instanceId}/abandon",
  "sourceUrl": "https://sit.neo.oa.api.longlian.online/v3/api-docs/%E7%94%A8%E6%88%B7%E7%AB%AF"
}

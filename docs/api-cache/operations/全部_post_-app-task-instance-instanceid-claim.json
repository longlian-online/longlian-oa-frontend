{
  "document": "全部",
  "method": "POST",
  "operation": {
    "description": "接取 PENDING 状态的任务，接取后任务状态变为 CLAIMED，归属当前登录用户；未加入企划时自动加入，返回本次是否新增关联",
    "operationId": "claimTask",
    "parameters": [
      {
        "in": "query",
        "name": "sessionContext",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/SessionContext"
        }
      },
      {
        "description": "任务实例ID",
        "in": "path",
        "name": "instanceId",
        "required": true,
        "schema": {
          "format": "int64",
          "type": "integer"
        }
      }
    ],
    "responses": {
      "200": {
        "content": {
          "*/*": {
            "schema": {
              "$ref": "#/components/schemas/TaskClaimResultVO"
            }
          }
        },
        "description": "OK"
      }
    },
    "summary": "接取任务",
    "tags": ["任务实例接口"]
  },
  "path": "/app/task/instance/{instanceId}/claim",
  "sourceUrl": "http://127.0.0.1:11003/v3/api-docs"
}

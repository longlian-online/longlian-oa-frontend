{
  "document": "用户端",
  "method": "POST",
  "operation": {
    "description": "企划创建人或下一阶段执行人可将已完成任务打回，保留接取人与提交历史。须匹配 revision 并填写打回意见，且后续阶段没有完成任务",
    "operationId": "rejectTask",
    "parameters": [
      {
        "in": "query",
        "name": "sessionContext",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/SessionContext"
        }
      },
      {
        "description": "任务实例ID",
        "in": "path",
        "name": "instanceId",
        "required": true,
        "schema": {
          "format": "int64",
          "type": "integer"
        }
      }
    ],
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/TaskRejectDTO"
          }
        }
      },
      "required": true
    },
    "responses": {
      "200": {
        "description": "OK"
      }
    },
    "summary": "打回任务",
    "tags": ["任务实例接口"]
  },
  "path": "/app/task/instance/{instanceId}/reject",
  "sourceUrl": "http://127.0.0.1:11003/v3/api-docs/%E7%94%A8%E6%88%B7%E7%AB%AF"
}

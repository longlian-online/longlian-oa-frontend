{
  "components": {
    "schemas": {
      "ApplicationInfoVO": {
        "description": "入组申请信息",
        "properties": {
          "appliedAt": {
            "description": "申请时间",
            "format": "date-time",
            "type": "string"
          },
          "avatarUrl": {
            "description": "申请人头像URL",
            "type": "string"
          },
          "id": {
            "description": "申请记录ID",
            "type": "string"
          },
          "nickname": {
            "description": "申请人昵称",
            "type": "string"
          },
          "userId": {
            "description": "申请人用户ID",
            "type": "string"
          },
          "username": {
            "description": "申请人用户名",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ApplicationListDTO": {
        "description": "入组申请列表查询请求参数",
        "properties": {
          "endApplyTime": {
            "description": "申请时间-结束",
            "format": "date-time",
            "type": "string"
          },
          "keyword": {
            "description": "昵称模糊搜索关键词",
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "orderDir": {
            "description": "排序方式，默认申请时间倒序",
            "enum": ["DESC", "ASC"],
            "type": "string"
          },
          "pageNum": {
            "description": "当前页码",
            "format": "int32",
            "minimum": 1,
            "type": "integer"
          },
          "pageSize": {
            "description": "每页条数",
            "format": "int32",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "startApplyTime": {
            "description": "申请时间-起始",
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ApplicationReviewDTO": {
        "description": "审核入组申请请求参数",
        "properties": {
          "applicationStatus": {
            "description": "审核结果：APPROVED-通过，REJECTED-拒绝",
            "enum": ["PENDING", "APPROVED", "REJECTED"],
            "type": "string"
          },
          "reviewRemark": {
            "description": "审核备注（拒绝时建议填写原因）",
            "maxLength": 500,
            "minLength": 0,
            "type": "string"
          }
        },
        "required": ["applicationStatus"],
        "type": "object"
      },
      "BaseTaskCreateDTO": {
        "description": "创建/更新原子任务请求参数",
        "properties": {
          "description": {
            "description": "任务说明",
            "maxLength": 500,
            "minLength": 0,
            "type": "string"
          },
          "iconFileId": {
            "description": "图标文件ID",
            "type": "string"
          },
          "metaSchema": {
            "description": "元数据字段定义(JSON数组)，示例：[{\"name\":\"附件\",\"fieldType\":\"file\",\"required\":true},{\"name\":\"作者\",\"fieldType\":\"text\",\"required\":true},{\"name\":\"源链接\",\"fieldType\":\"text\",\"required\":true}]",
            "type": "string"
          },
          "name": {
            "description": "任务名称（如：创建/翻译/校对）",
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          }
        },
        "required": ["name"],
        "type": "object"
      },
      "BaseTaskListDTO": {
        "description": "原子任务列表查询请求参数",
        "properties": {
          "endCreatedTime": {
            "description": "创建时间-结束",
            "format": "date-time",
            "type": "string"
          },
          "keyword": {
            "description": "任务名称模糊搜索关键词",
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "orderDir": {
            "description": "排序方式，默认倒序",
            "enum": ["DESC", "ASC"],
            "type": "string"
          },
          "pageNum": {
            "description": "当前页码",
            "format": "int32",
            "minimum": 1,
            "type": "integer"
          },
          "pageSize": {
            "description": "每页条数",
            "format": "int32",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "sortBy": {
            "description": "排序字段：CREATED_AT-创建时间，REF_COUNT-引用次数，默认 REF_COUNT",
            "enum": ["CREATED_AT", "REF_COUNT"],
            "type": "string"
          },
          "startCreatedTime": {
            "description": "创建时间-起始",
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "description": "状态精确筛选：ENABLED-启用，DISABLED-禁用，默认查启用",
            "enum": ["ENABLED", "DISABLED"],
            "type": "string"
          }
        },
        "type": "object"
      },
      "BaseTaskVO": {
        "description": "原子任务信息",
        "properties": {
          "createdAt": {
            "description": "创建时间",
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "description": "任务说明",
            "type": "string"
          },
          "iconUrl": {
            "description": "图标URL",
            "type": "string"
          },
          "id": {
            "description": "原子任务ID",
            "type": "string"
          },
          "metaSchema": {
            "description": "元数据字段定义(JSON数组)",
            "type": "string"
          },
          "name": {
            "description": "任务名称",
            "type": "string"
          },
          "refCount": {
            "description": "引用次数（该任务被引用到任务流模板节点中的次数）",
            "format": "int32",
            "type": "integer"
          },
          "status": {
            "description": "状态：ENABLED-启用，DISABLED-禁用",
            "enum": ["ENABLED", "DISABLED"],
            "type": "string"
          }
        },
        "type": "object"
      },
      "ChangeStatusDTO": {
        "description": "修改状态请求参数",
        "properties": {
          "status": {
            "description": "目标状态：ENABLED-启用，DISABLED-禁用",
            "enum": ["ENABLED", "DISABLED"],
            "type": "string"
          }
        },
        "required": ["status"],
        "type": "object"
      },
      "InviteCodeVO": {
        "description": "邀请码（可用于创建组织、注册入组或已注册用户申请入组）",

          },
          "sortBy": {
            "description": "排序字段：CREATED_AT-创建时间，REF_COUNT-引用次数，默认 REF_COUNT",
            "enum": ["CREATED_AT", "REF_COUNT"],
            "type": "string"
          },
          "startCreatedTime": {
            "description": "创建时间-起始",
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "description": "状态精确筛选：ENABLED-启用，DISABLED-禁用，默认查启用",
            "enum": ["ENABLED", "DISABLED"],
            "type": "string"
          }
        },
        "type": "object"
      },
      "TaskTemplateListVO": {
        "description": "任务模板列表行信息",
        "properties": {
          "createdAt": {
            "description": "创建时间",
            "format": "date-time",
            "type": "string"
          },
          "creatorId": {
            "description": "创建人ID",
            "type": "string"
          },
          "creatorNickname": {
            "description": "创建人昵称",
            "type": "string"
          },
          "description": {
            "description": "模板说明",
            "type": "string"
          },
          "id": {
            "description": "模板ID",
            "type": "string"
          },
          "name": {
            "description": "模板名称",
            "type": "string"
          },
          "refCount": {
            "description": "引用次数（已基于该模板创建的任务流数量）",
            "format": "int32",
            "type": "integer"
          },
          "status": {
            "description": "状态：ENABLED-启用，DISABLED-禁用",
            "enum": ["ENABLED", "DISABLED"],
            "type": "string"
          }
        },
        "type": "object"
      },
      "TaskTemplateNodeDTO": {
        "description": "任务模板节点（创建/更新模板时使用）",
        "properties": {
          "baseTaskId": {
            "description": "关联的原子任务ID",
            "type": "string"
          },
          "parallelSort": {
            "description": "并行组内排序（sort 相同时，用于控制并行节点的展示顺序）",
            "format": "int32",
            "type": "integer"
          },
          "sort": {
            "description": "步骤顺序（同一 sort 值的节点为并行节点）",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": ["baseTaskId", "sort"],
        "type": "object"
      },
      "TaskTemplateNodeVO": {
        "description": "任务模板节点信息",
        "properties": {
          "baseTaskIconUrl": {
            "description": "原子任务图标URL",
            "type": "string"
          },
          "baseTaskId": {
            "description": "关联原子任务ID",
            "type": "string"
          },
          "baseTaskName": {
            "description": "原子任务名称",
            "type": "string"
          },
          "id": {
            "description": "模板节点ID",
            "type": "string"
          },
          "metaSchema": {
            "description": "元数据字段定义(JSON数组)",
            "type": "string"
          },
          "parallelSort": {
            "description": "并行组内排序",
            "format": "int32",
            "type": "integer"
          },
          "sort": {
            "description": "步骤顺序（相同 sort 值表示并行节点）",
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      }
    },

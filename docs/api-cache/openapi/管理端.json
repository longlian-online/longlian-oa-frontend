{
  "components": {
    "schemas": {
      "AdminCreateDTO": {
        "description": "创建管理员请求参数",
        "properties": {
          "password": {
            "description": "密码",
            "maxLength": 64,
            "minLength": 6,
            "type": "string"
          },
          "username": {
            "description": "用户名",
            "maxLength": 32,
            "minLength": 3,
            "type": "string"
          }
        },
        "required": ["password", "username"],
        "type": "object"
      },
      "AdminListDTO": {
        "description": "管理员列表查询请求参数",
        "properties": {
          "pageNum": {
            "description": "当前页码",
            "format": "int32",
            "minimum": 1,
            "type": "integer"
          },
          "pageSize": {
            "description": "每页条数",
            "format": "int32",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "AdminLoginDTO": {
        "description": "管理员登录请求参数",
        "properties": {
          "password": {
            "description": "密码",
            "maxLength": 64,
            "minLength": 6,
            "type": "string"
          },
          "username": {
            "description": "用户名",
            "maxLength": 32,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["password", "username"],
        "type": "object"
      },
      "AdminLoginVO": {
        "description": "管理员登录结果视图对象",
        "properties": {
          "adminId": {
            "description": "管理员ID",
            "type": "string"
          },
          "role": {
            "description": "角色",
            "type": "string"
          },
          "token": {
            "description": "登录令牌",
            "type": "string"
          },
          "username": {
            "description": "用户名",
            "type": "string"
          }
        },
        "type": "object"
      },
      "AdminVO": {
        "description": "管理员信息视图对象",
        "properties": {
          "createdAt": {
            "description": "创建时间",
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "description": "管理员ID",
            "type": "string"
          },
          "lastLoginAt": {
            "description": "最后登录时间",
            "format": "date-time",
            "type": "string"
          },
          "role": {
            "description": "角色",
            "type": "string"
          },
          "username": {
            "description": "用户名",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ChangeStatusDTO": {
        "description": "修改状态请求参数",
        "properties": {
          "status": {
            "description": "目标状态：ENABLED-启用，DISABLED-禁用",
            "enum": ["ENABLED", "DISABLED"],
            "type": "string"
          }
        },
        "required": ["status"],
        "type": "object"
      },
      "GenerateInviteCodeDTO": {
        "description": "生成邀请码请求参数",
        "properties": {
          "expiredAt": {
            "description": "邀请人选择的到期时间",
            "format": "date-time",
            "type": "string"
          }
        },
        "required": ["expiredAt"],
        "type": "object"
      },
      "InviteCodeVO": {
        "description": "邀请码（可用于创建组织、注册入组或已注册用户申请入组）",
        "properties": {
          "expireAt": {
            "description": "邀请码过期时间",
            "type": "string"
          },
          "id": {
            "description": "邀请记录 ID，仅加入组织邀请码返回",
            "type": "string"
          },
          "inviteCode": {
            "description": "邀请码（6位字母数字）",
            "type": "string"
          },
          "maxUses": {
            "description": "使用上限，为空表示不限次数；创建组织邀请码不返回",
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "OrgDetailInfoVO": {
        "description": "组织详细信息",
        "properties": {
          "avatarUrl": {
            "description": "组织头像文件url",
            "type": "string"
          },
          "createdAt": {
            "description": "组织创建时间",
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "description": "组织ID",
            "type": "string"
          },
          "name": {
            "description": "组织名称",
            "type": "string"
          },
          "status": {
            "description": "组织状态 1-启用 0-禁用",
            "enum": ["ENABLED", "DISABLED"],
            "type": "string"
          }
        },
        "type": "object"
      },
      "OrgListDTO": {
        "description": "组织列表查询请求参数",
        "properties": {
          "endCreateTime": {
            "description": "创建时间-结束",
            "format": "date-time",
            "type": "string"
          },
          "orderDir": {
            "description": "排序方式",
            "enum": ["DESC", "ASC"],
            "type": "string"
          },
          "orgName": {
            "description": "组织名",
            "maxLength": 32,
            "minLength": 0,
            "type": "string"
          },
          "pageNum": {
            "description": "当前页码",
            "format": "int32",
            "minimum": 1,
            "type": "integer"
          },
          "pageSize": {
            "description": "每页条数",
            "format": "int32",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "startCreateTime": {
            "description": "创建时间-起始",
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      },
      "PageResultVOAdminVO": {
        "description": "通用分页返回结果",
        "properties": {
          "list": {
            "description": "数据列表",
            "items": {
              "$ref": "#/components/schemas/AdminVO"
            },
            "type": "array"
          },
          "total": {
            "description": "总条数",
            "format": "int64",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "PageResultVOOrgDetailInfoVO": {
        "description": "通用分页返回结果",
        "properties": {
          "list": {
            "description": "数据列表",
            "items": {
              "$ref": "#/components/schemas/OrgDetailInfoVO"
            },
            "type": "array"
          },
          "total": {
            "description": "总条数",
            "format": "int64",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "PageResultVOProductReleaseListItemVO": {
        "description": "通用分页返回结果",
        "properties": {
          "list": {
            "description": "数据列表",
            "items": {
              "$ref": "#/components/schemas/ProductReleaseListItemVO"
            },
            "type": "array"
          },
          "total": {
            "description": "总条数",
            "format": "int64",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "PageResultVOStorageStatsVO": {
        "description": "通用分页返回结果",
        "properties": {
          "list": {
            "description": "数据列表",
            "items": {
              "$ref": "#/components/schemas/StorageStatsVO"
            },
            "type": "array"
          },
          "total": {
            "description": "总条数",
            "format": "int64",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "ProductReleaseBaselineVO": {
        "properties": {
          "backendVersion": {
            "type": "string"
          },
          "frontendVersion": {
            "type": "string"
          },
          "publishedAt": {
            "format": "date-time",
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "ProductReleaseDetailVO": {
        "properties": {
          "backendVersion": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "frontendVersion": {
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "publishedAt": {
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "enum": ["DRAFT", "PUBLISHED", "WITHDRAWN"],
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "ProductReleaseListDTO": {
        "description": "产品版本列表查询",
        "properties": {
          "pageNum": {
            "description": "当前页码",
            "format": "int32",
            "minimum": 1,
            "type": "integer"
          },
          "pageSize": {
            "description": "每页条数",
            "format": "int32",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "status": {
            "description": "状态，不传则全部",
            "enum": ["DRAFT", "PUBLISHED", "WITHDRAWN"],
            "type": "string"
          }
        },
        "type": "object"
      },
      "ProductReleaseListItemVO": {
        "description": "数据列表",
        "properties": {
          "backendVersion": {
            "type": "string"
          },
          "frontendVersion": {
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "publishedAt": {
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "enum": ["DRAFT", "PUBLISHED", "WITHDRAWN"],
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "ProductReleaseSaveDTO": {
        "description": "保存产品版本",
        "properties": {
          "backendVersion": {
            "pattern": "^[vV]?(0|[1-9]\\d{0,6})\\.(0|[1-9]\\d{0,6})\\.(0|[1-9]\\d{0,6})$",
            "type": "string"
          },
          "content": {
            "description": "更新说明，Markdown",
            "maxLength": 4000,
            "minLength": 0,
            "type": "string"
          },
          "frontendVersion": {
            "pattern": "^[vV]?(0|[1-9]\\d{0,6})\\.(0|[1-9]\\d{0,6})\\.(0|[1-9]\\d{0,6})$",
            "type": "string"
          },
          "publish": {
            "description": "为 true 时创建并发布；更新接口忽略",
            "type": "boolean"
          },
          "summary": {
            "maxLength": 120,
            "minLength": 0,
            "type": "string"
          },
          "title": {
            "maxLength": 40,
            "minLength": 0,
            "type": "string"
          },
          "version": {
            "pattern": "^[vV]?(0|[1-9]\\d{0,6})\\.(0|[1-9]\\d{0,6})\\.(0|[1-9]\\d{0,6})$",
            "type": "string"
          }
        },
        "required": ["backendVersion", "frontendVersion", "version"],
        "type": "object"
      },
      "ScheduleTriggerDTO": {
        "description": "手动触发定时任务请求",
        "properties": {
          "executeTime": {
            "description": "上层传递的执行时间，为 null 时默认使用当前时间",
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ScheduledTaskVO": {
        "description": "定时任务列表项",
        "properties": {
          "cronExpression": {
            "description": "cron 表达式，为 null 表示仅支持手动触发",
            "type": "string"
          },
          "description": {
            "description": "任务描述",
            "type": "string"
          },
          "enabled": {
            "description": "是否启用定时调度",
            "type": "boolean"
          },
          "taskName": {
            "description": "任务唯一标识",
            "type": "string"
          }
        },
        "type": "object"
      },
      "StorageCategoryStatsVO": {
        "description": "一类资源的四种存储状态",
        "properties": {
          "active": {
            "$ref": "#/components/schemas/StorageStateStatsVO"
          },
          "recycled": {
            "$ref": "#/components/schemas/StorageStateStatsVO"
          },
          "retention": {
            "$ref": "#/components/schemas/StorageStateStatsVO"
          },
          "unbound": {
            "$ref": "#/components/schemas/StorageStateStatsVO"
          }
        },
        "type": "object"
      },
      "StorageStateStatsVO": {
        "description": "一种存储状态的数量和字节",
        "properties": {
          "bytes": {
            "description": "字节数",
            "format": "int64",
            "type": "integer"
          },
          "count": {
            "description": "文件数",
            "format": "int64",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "StorageStatsQueryDTO": {
        "description": "存储统计查询参数",
        "properties": {
          "orgName": {
            "description": "组织名",
            "maxLength": 32,
            "minLength": 0,
            "type": "string"
          },
          "pageNum": {
            "description": "当前页码",
            "format": "int32",
            "minimum": 1,
            "type": "integer"
          },
          "pageSize": {
            "description": "每页条数",
            "format": "int32",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "StorageStatsVO": {
        "description": "组织存储统计",
        "properties": {
          "cover": {
            "$ref": "#/components/schemas/StorageCategoryStatsVO"
          },
          "id": {
            "description": "组织ID",
            "type": "string"
          },
          "name": {
            "description": "组织名称",
            "type": "string"
          },
          "occupiedBytes": {
            "description": "仍占用的字节，不含已回收和头像",
            "format": "int64",
            "type": "integer"
          },
          "reclaimedBytes": {
            "description": "已物理回收的字节，不含头像",
            "format": "int64",
            "type": "integer"
          },
          "status": {
            "description": "组织状态",
            "enum": ["ENABLED", "DISABLED"],
            "type": "string"
          },
          "taskSubmit": {
            "$ref": "#/components/schemas/StorageCategoryStatsVO"
          },
          "thumbnail": {
            "$ref": "#/components/schemas/StorageCategoryStatsVO"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "Authorization": {
        "bearerFormat": "JWT",
        "in": "header",
        "name": "Authorization",
        "scheme": "Bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {
      "name": "longlian"
    },
    "description": "longlian的接口文档示例",
    "title": "longlian接口文档",
    "version": "v1.0.0"
  },
  "openapi": "3.0.1",
  "paths": {
    "/admin/admins/": {
      "get": {
        "operationId": "list_2",
        "parameters": [
          {
            "in": "query",
            "name": "dto",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AdminListDTO"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageResultVOAdminVO"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "分页查询管理员列表",
        "tags": ["管理员接口"]
      },
      "post": {
        "operationId": "create_1",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminCreateDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "创建管理员",
        "tags": ["管理员接口"]
      }
    },
    "/admin/admins/{id}": {
      "delete": {
        "operationId": "delete",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "summary": "删除管理员",
        "tags": ["管理员接口"]
      }
    },
    "/admin/organizations/": {
      "get": {
        "operationId": "getOrgListInfo",
        "parameters": [
          {
            "in": "query",
            "name": "dto",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/OrgListDTO"
            }
          }

{
  "components": {
    "schemas": {
      "AdminCreateDTO": {
        "description": "创建管理员请求参数",
        "properties": {
          "password": {
            "description": "密码",
            "maxLength": 64,
            "minLength": 6,
            "type": "string"
          },
          "username": {
            "description": "用户名",
            "maxLength": 32,
            "minLength": 3,
            "type": "string"
          }
        },
        "required": ["password", "username"],
        "type": "object"
      },
      "AdminListDTO": {
        "description": "管理员列表查询请求参数",
        "properties": {
          "pageNum": {
            "description": "当前页码",
            "format": "int32",
            "minimum": 1,
            "type": "integer"
          },
          "pageSize": {
            "description": "每页条数",
            "format": "int32",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "AdminLoginDTO": {
        "description": "管理员登录请求参数",
        "properties": {
          "password": {
            "description": "密码",
            "maxLength": 64,
            "minLength": 6,
            "type": "string"
          },
          "username": {
            "description": "用户名",
            "maxLength": 32,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["password", "username"],
        "type": "object"
      },
      "AdminLoginVO": {
        "description": "管理员登录结果视图对象",
        "properties": {
          "adminId": {
            "description": "管理员ID",
            "type": "string"
          },
          "role": {
            "description": "角色",
            "type": "string"
          },
          "token": {
            "description": "登录令牌",
            "type": "string"
          },
          "username": {
            "description": "用户名",
            "type": "string"
          }
        },
        "type": "object"
      },
      "AdminVO": {
        "description": "管理员信息视图对象",
        "properties": {
          "createdAt": {
            "description": "创建时间",
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "description": "管理员ID",
            "format": "int64",
            "type": "integer"
          },
          "lastLoginAt": {
            "description": "最后登录时间",
            "format": "date-time",
            "type": "string"
          },
          "role": {
            "description": "角色",
            "type": "string"
          },
          "username": {
            "description": "用户名",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ChangeStatusDTO": {
        "description": "修改状态请求参数",
        "properties": {
          "status": {
            "description": "目标状态：ENABLED-启用，DISABLED-禁用",
            "enum": ["ENABLED", "DISABLED"],
            "type": "string"
          }
        },
        "required": ["status"],
        "type": "object"
      },
      "InviteCodeVO": {
        "description": "邀请码（可用于创建组织、注册入组或已注册用户申请入组）",
        "properties": {
          "expireAt": {
            "description": "邀请码过期时间",
            "type": "string"
          },
          "inviteCode": {
            "description": "邀请码（6位字母数字，一次性使用，有效期30分钟）",
            "type": "string"
          }
        },
        "type": "object"
      },
      "OrgDetailInfoVO": {
        "description": "组织详细信息",
        "properties": {
          "avatarUrl": {
            "description": "组织头像文件url",
            "type": "string"
          },
          "createdAt": {
            "description": "组织创建时间",
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "description": "组织ID",
            "type": "string"
          },
          "name": {
            "description": "组织名称",
            "type": "string"
          },
          "status": {
            "description": "组织状态 1-启用 0-禁用",
            "enum": ["ENABLED", "DISABLED"],
            "type": "string"
          }
        },
        "type": "object"
      },
      "OrgListDTO": {
        "description": "组织列表查询请求参数",
        "properties": {
          "endCreateTime": {
            "description": "创建时间-结束",
            "format": "date-time",
            "type": "string"
          },
          "orderDir": {
            "description": "排序方式",
            "enum": ["DESC", "ASC"],
            "type": "string"
          },
          "orgName": {
            "description": "组织名",
            "maxLength": 32,
            "minLength": 0,
            "type": "string"
          },
          "pageNum": {
            "description": "当前页码",
            "format": "int32",
            "minimum": 1,
            "type": "integer"
          },
          "pageSize": {
            "description": "每页条数",
            "format": "int32",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "startCreateTime": {
            "description": "创建时间-起始",
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      },
      "PageResultVOAdminVO": {
        "description": "通用分页返回结果",
        "properties": {
          "list": {
            "description": "数据列表",
            "items": {
              "$ref": "#/components/schemas/AdminVO"
            },
            "type": "array"
          },
          "total": {
            "description": "总条数",
            "format": "int64",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "PageResultVOOrgDetailInfoVO": {
        "description": "通用分页返回结果",
        "properties": {
          "list": {
            "description": "数据列表",
            "items": {
              "$ref": "#/components/schemas/OrgDetailInfoVO"
            },
            "type": "array"
          },
          "total": {
            "description": "总条数",
            "format": "int64",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "ScheduleTriggerDTO": {
        "description": "手动触发定时任务请求",
        "properties": {
          "executeTime": {
            "description": "上层传递的执行时间，为 null 时默认使用当前时间",
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ScheduledTaskVO": {
        "description": "定时任务列表项",
        "properties": {
          "cronExpression": {
            "description": "cron 表达式，为 null 表示仅支持手动触发",
            "type": "string"
          },
          "description": {
            "description": "任务描述",
            "type": "string"
          },
          "enabled": {
            "description": "是否启用定时调度",
            "type": "boolean"
          },
          "taskName": {
            "description": "任务唯一标识",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "Authorization": {
        "bearerFormat": "JWT",
        "in": "header",
        "name": "Authorization",
        "scheme": "Bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {
      "name": "longlian"
    },
    "description": "longlian的接口文档示例",
    "title": "longlian接口文档",
    "version": "v1.0.0"
  },
  "openapi": "3.0.1",
  "paths": {
    "/admin/admins/": {
      "get": {
        "operationId": "list",
        "parameters": [
          {
            "in": "query",
            "name": "dto",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AdminListDTO"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageResultVOAdminVO"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "分页查询管理员列表",
        "tags": ["管理员接口"]
      },
      "post": {
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminCreateDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "创建管理员",
        "tags": ["管理员接口"]
      }
    },
    "/admin/admins/{id}": {
      "delete": {
        "operationId": "delete",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "summary": "删除管理员",
        "tags": ["管理员接口"]
      }
    },
    "/admin/organizations/": {
      "get": {
        "operationId": "getOrgListInfo",
        "parameters": [
          {
            "in": "query",
            "name": "dto",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/OrgListDTO"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageResultVOOrgDetailInfoVO"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "分页查询组织列表",
        "tags": ["组织接口"]
      }
    },
    "/admin/organizations/invite-codes/create-org": {
      "post": {
        "description": "生成一次性邀请码，有效期30分钟；供超管邀请新用户注册并创建组织使用",
        "operationId": "generateCreateOrgInviteCode",
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/InviteCodeVO"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "生成邀请码（超管）",
        "tags": ["组织接口"]
      }
    },
    "/admin/organizations/{orgId}/status": {
      "patch": {
        "description": "启用或禁用指定组织。status: ENABLED-启用，DISABLED-禁用",
        "operationId": "changeOrgStatus",
        "parameters": [
          {
            "in": "path",
            "name": "orgId",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeStatusDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "summary": "操作组织状态",
        "tags": ["组织接口"]
      }
    },
    "/admin/scheduled-tasks/": {
      "get": {
        "operationId": "listTasks",
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ScheduledTaskVO"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "列出所有已注册的定时任务",
        "tags": ["定时任务管理"]
      }
    },
    "/admin/scheduled-tasks/{taskName}/trigger": {
      "post": {
        "description": "传入 executeTime 可模拟任意时间点触发，不传则为当前时间。",
        "operationId": "trigger",
        "parameters": [
          {
            "in": "path",
            "name": "taskName",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScheduleTriggerDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "summary": "手动触发定时任务",
        "tags": ["定时任务管理"]
      }
    },
    "/admin/session": {
      "delete": {
        "operationId": "logout",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "summary": "管理员登出",
        "tags": ["管理员会话接口"]
      },
      "post": {
        "description": "使用用户名+密码登录",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminLoginDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AdminLoginVO"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "管理员登录",
        "tags": ["管理员会话接口"]
      }
    }
  },

#!/bin/sh

commit_msg_file="$1"
commit_msg=$(cat "$commit_msg_file")

# Merge commit 跳过校验
if echo "$commit_msg" | grep -qiE "^Merge"; then
  exit 0
fi

pattern="^(upd|feat|fix|docs|style|refactor|chore|revert)(\(.+\))?: .{1,50}"

if ! echo "$commit_msg" | grep -qE "$pattern"; then
  echo ""
  echo "✖ commit message 格式不正确"
  echo ""
  echo "  格式要求: <type>(<scope>): <subject>"
  echo ""
  echo "  允许的 type:"
  echo "    upd       - 更新/优化已有功能"
  echo "    feat      - 新功能"
  echo "    fix       - Bug 修复"
  echo "    docs      - 文档变更"
  echo "    style     - 代码格式（不影响逻辑）"
  echo "    refactor  - 重构"
  echo "    chore     - 构建/工具/依赖变更"
  echo "    revert    - 回滚"
  echo ""
  echo "  示例:"
  echo "    feat: add login page"
  echo "    fix(auth): handle token expiration"
  echo "    upd(dashboard): optimize chart rendering"
  echo ""
  echo "  当前 message: $commit_msg"
  echo ""
  exit 1
fi

exit 0
